{
    "name": "fixture/generic-composer-phpcs",
    "description": "Composer library that enforces its coding standard with PHPCS, not PHP-CS-Fixer.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\Phpcs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fixture\\Phpcs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "phpcs",
        "cs:fix": "phpcbf"
    }
}
